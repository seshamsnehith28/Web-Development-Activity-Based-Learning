<title>The Daily Times | Latest News</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
    color: #222;
    line-height: 1.6;
}

header {
    background: #b90016;
    color: white;
    padding: 22px 5%;
    text-align: center;
}

header h1 {
    font-family: Georgia, serif;
    font-size: 42px;
    letter-spacing: -1px;
}

header p {
    font-size: 12px;
    letter-spacing: 3px;
}

.date {
    background: #eeeeee;
    padding: 8px 5%;
    font-size: 12px;
    display: flex;
    justify-content: space-between;
}

nav {
    background: white;
    border-bottom: 2px solid #b90016;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    padding: 12px;
    gap: 30px;
}

nav a {
    text-decoration: none;
    color: #222;
    font-weight: bold;
    font-size: 14px;
}

nav a:hover {
    color: #b90016;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: 25px auto;
}

.section-title {
    border-left: 5px solid #b90016;
    padding-left: 12px;
    margin-bottom: 18px;
    font-size: 23px;
}

.featured {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
    margin-bottom: 35px;
}

.main-story, .side-story, .card {
    background: white;
    border-radius: 5px;
    overflow: hidden;
    box-shadow: 0 2px 8px #00000012;
}

.main-story img {
    width: 100%;
    height: 340px;
    object-fit: cover;
}

.side-story img {
    width: 100%;
    height: 150px;
    object-fit: cover;
}

.story-content {
    padding: 18px;
}

.category {
    color: #b90016;
    font-size: 12px;
    font-weight: bold;
    text-transform: uppercase;
}

.story-content h2 {
    font-family: Georgia, serif;
    font-size: 25px;
    line-height: 1.3;
    margin: 8px 0;
}

.story-content p {
    color: #666;
    font-size: 14px;
}

.author {
    color: #888;
    font-size: 12px;
    margin-top: 12px;
}

.side-stories {
    display: grid;
    gap: 15px;
}

.side-story .story-content h2 {
    font-size: 17px;
}

.news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 35px;
}

.card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
}

.card .story-content h2 {
    font-size: 19px;
}

.search-box {
    display: flex;
    gap: 8px;
}

.search-box input {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    width: 220px;
}

footer {
    background: #222;
    color: white;
    text-align: center;
    padding: 30px 10px;
    margin-top: 40px;
}

footer p {
    font-size: 13px;
    color: #ccc;
}

@media(max-width: 768px) {
    header h1 {
        font-size: 30px;
    }

    nav {
        gap: 15px;
    }

    .featured {
        grid-template-columns: 1fr;
    }

    .news-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .main-story img {
        height: 240px;
    }

    .date {
        gap: 10px;
        flex-wrap: wrap;
    }
}

@media(max-width: 480px) {
    .news-grid {
        grid-template-columns: 1fr;
    }

    nav {
        gap: 12px;
    }

    nav a {
        font-size: 12px;
    }

    .container {
        width: 94%;
    }

    .story-content h2 {
        font-size: 21px;
    }
}
</style>
</head>

