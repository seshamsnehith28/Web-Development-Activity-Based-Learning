<!DOCTYPE html>
<html >
<head>
    <title>NRI University</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #F2F5F7;
            color: #333333;
            margin: 0;
        }

        header {
            background-color: #FFFFFF;
            text-align: center;
            padding: 20px;
        }

        h1 {
            color: #FF7900;
            font-size: 32px;
        }

        h2 {
            color: #FF7900;
            text-align: center;
        }

        h3 {
            color: #303A3D;
        }

        p {
            font-size: 16px;
            line-height: 1.6;
        }

        /* Navigation Bar */
        nav {
            background-color: #303A3D;
            text-align: center;
            padding: 15px;
        }

        nav a {
            color: #FFFFFF;
            text-decoration: none;
            margin: 10px;
            font-size: 15px;
        }

        nav a:hover {
            color: #FF7900;
        }

        /* Banner */
        .banner {
            background-image: url("https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=1200&q=80");
            background-size: cover;
            background-position: center;
            height: 300px;
            padding: 40px;
            text-align: center;
            color: #FFFFFF;
        }

        .banner h2 {
            color: #FFFFFF;
            font-size: 35px;
        }

        .banner p {
            font-size: 18px;
        }

        /* Container */
        .container {
            padding: 25px;
            margin: 15px;
        }

        /* Information Cards */
        .card {
            background-color: #FFFFFF;
            border: 2px solid #DDDDDD;
            width: 280px;
            padding: 15px;
            margin: 10px;
            display: inline-block;
            vertical-align: top;
            text-align: left;
        }

        .card img {
            width: 100%;
            height: 160px;
        }

        .card h3 {
            background-color: #FF7900;
            color: #FFFFFF;
            padding: 10px;
            text-align: center;
        }

        /* Links and Buttons */
        .button {
            background-color: #FF7900;
            color: #FFFFFF;
            padding: 10px;
            text-decoration: none;
            display: inline-block;
            margin: 5px;
        }

        /* About Section */
        .about {
            background-color: #FFFFFF;
            padding: 25px;
            text-align: center;
        }

        /* Admissions */
        .admission {
            background-color: #FF7900;
            color: #FFFFFF;
            padding: 30px;
            text-align: center;
        }

        .admission h2 {
            color: #FFFFFF;
        }

        /* Contact */
        .contact {
            background-color: #FFFFFF;
            padding: 25px;
        }

        /* Footer */
        footer {
            background-color: #303A3D;
            color: #FFFFFF;
            text-align: center;
            padding: 25px;
        }

        footer a {
            color: #FFFFFF;
            text-decoration: none;
            margin: 8px;
        }

        hr {
            border: 1px solid #FF7900;
        }

        /* Mobile-First Basic Design */
        @media (max-width: 600px) {
            .card {
                width: 85%;
                margin: 10px auto;
                display: block;
            }

            .banner {
                height: 250px;
                padding: 20px;
            }

            .banner h2 {
                font-size: 27px;
            }

            nav a {
                display: inline-block;
                margin: 7px;
            }
        }
    </style>
</head>

